{
	# Admin API on loopback only: used for worker restart/inspection, not exposed
	admin 127.0.0.1:2019

	# Plain HTTP only — TLS is terminated by the platform ingress / Traefik
	auto_https off

	frankenphp {
		# Threads for non-worker traffic; worker threads are added on top
		num_threads {$PHP_NUM_THREADS:2}
		# fail fast instead of queueing forever when all threads are busy
		max_wait_time {$PHP_MAX_WAIT_TIME:10s}

		php_ini memory_limit {$PHP_MEMORY_LIMIT:512M}
		php_ini max_execution_time {$PHP_MAX_EXECUTION_TIME:9}
		php_ini opcache.jit 0
	}

	servers {
		# trust X-Forwarded-* from private networks (ingress / Traefik)
		trusted_proxies static private_ranges
		timeouts {
			read_body 10s
			read_header 10s
			idle 5m
		}
	}
}

http://:{$PORT:8080} {
	root * /app/public

	encode zstd gzip

	# OTLP/grpc request spans via env config (OTEL_EXPORTER_OTLP_*); provides
	# request tracing with a correct per-request lifecycle (opentelemetry-php
	# auto-instrumentation is disabled under FrankenPHP worker mode — spans
	# never end per request, see config comment in taocloud-k8s devkit).
	tracing {
		span devkit
	}

	log {
		output stdout
		format json
	}

	php_server {
		worker {
			file /app/public/index.php
			num {$WORKER_NUM:2}
			env APP_RUNTIME App\Runtime\FrankenPhpRuntime
			env APP_ENV prod
			env APP_DEBUG 0
			env FRANKENPHP_LOOP_MAX {$FRANKENPHP_LOOP_MAX:500}
		}
	}
}
